{
  "name": "@docfide/duct",
  "version": "0.2.0",
  "description": "Document intelligence pipeline \u2014 extract, chunk, embed, and search any document format",
  "type": "module",
  "bin": {
    "duct": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./client": {
      "types": "./dist/api/client.d.ts",
      "import": "./dist/api/client.js"
    }
  },
  "files": [
    "dist",
    "assets/mascot",
    "assets/ocr",
    "assets/ui"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --mac --linux --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "icons": "node scripts/build-icons.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "build": {
    "appId": "com.docfide.duct",
    "productName": "Duct",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/mascot/**/*",
      "assets/ocr/**/*",
      "assets/ui/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "electron/icon.png"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asarUnpack": [
      "assets/ocr/**"
    ]
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@lottiefiles/dotlottie-web": "^0.81.0",
    "canvas": "^3.2.3",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "express": "^4.18.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "marked": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.0.0",
    "ora": "^9.4.0",
    "pdfjs-dist": "^5.7.284",
    "postal-mime": "^4.0.5",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@mistralai/mistralai": "^2.2.5",
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.20.5",
    "cohere-ai": "^8.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "express-rate-limit": "^8.5.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7",
    "voyageai": "^0.2.1"
  },
  "optionalDependencies": {
    "@google/generative-ai": "^0.21.0",
    "@mistralai/mistralai": "^2.0.0",
    "cohere-ai": "^8.0.0",
    "heic-decode": "^2.1.0",
    "voyageai": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docfide/duct.git"
  },
  "homepage": "https://github.com/docfide/duct#readme",
  "bugs": {
    "url": "https://github.com/docfide/duct/issues"
  },
  "keywords": [
    "document",
    "extraction",
    "rag",
    "search",
    "pdf",
    "docx",
    "markdown",
    "embeddings",
    "cli",
    "pipeline"
  ],
  "author": "Tensflare Ltd",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
