# ---- Required ----
# The address people will use. Its DNS must point at this server.
DUCT_DOMAIN=duct.example.com

# Sign-in with your identity provider (OpenID Connect). Register a web app with the redirect URI
#   https://<DUCT_DOMAIN>/auth/callback
# Google Workspace: https://accounts.google.com
# Microsoft Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# Okta: https://<your-org>.okta.com
DUCT_OIDC_ISSUER=
DUCT_OIDC_CLIENT_ID=
DUCT_OIDC_CLIENT_SECRET=
# At least one admin. Members: whole domains and/or individual addresses (comma-separated).
DUCT_ADMIN_EMAILS=it@example.com
DUCT_ALLOW_DOMAINS=example.com
DUCT_ALLOW_EMAILS=
# Keeps people signed in across restarts. Generate with: openssl rand -hex 32
DUCT_SESSION_SECRET=

# ---- Optional ----
# The Duct image; pin a release tag (see https://github.com/docfide/duct/releases).
DUCT_IMAGE=ghcr.io/docfide/duct:v1.0.0-alpha.1
# Folder on this machine to search (mounted read-only at /docs).
DUCT_DOCS=./docs
# Scripts and integrations: an admin token for the API (people sign in instead). openssl rand -hex 24
DUCT_AUTH_TOKEN=

# Cloud sources (Team plan). Your own OAuth apps, with the redirect URI https://<DUCT_DOMAIN>/connectors/callback
DUCT_GOOGLE_CLIENT_ID=
DUCT_GOOGLE_CLIENT_SECRET=
DUCT_MICROSOFT_CLIENT_ID=
